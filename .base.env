# Environment variables declared in this file are automatically made available to Prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

DATABASE_URL="mysql://<usr>:<pass>@<host>:<ip>/<db>"

# NextAuth
NEXTAUTH_SECRET=<nextauth-secret>

# Providers
GITHUB_ID=<github-id>
GITHUB_SECRET=<github-secret>

# Constants

# Nextjs api url. this is necessary for the server components to work
SERVER_URL=<server-url>
PORT=<server-port>

# Gnosis Main api url (browser: gateway)
NEXT_PUBLIC_API_URL=<gnosis-gateway-url>
# Server-side login / issue-token (main-service, not through the gateway)
MAIN_API_URL=<gnosis-main-service-url>
GATEWAY_INTERNAL_SECRET=<shared-secret-with-gateway-and-main-service>
NEXT_PUBLIC_TITLE=Gnosis